{"questions":[{"id":1,"question":"What is the only mandatory section in a CloudFormation template?","options":[{"letter":"A","text":"Parameters"},{"letter":"B","text":"Outputs"},{"letter":"C","text":"Resources"},{"letter":"D","text":"Metadata"}],"correctAnswer":"C","difficulty":"basic","explanation":{"correct":"Resources is mandatory.","why":"Other sections are optional."}},{"id":2,"question":"What is a CloudFormation stack?","options":[{"letter":"A","text":"Template file"},{"letter":"B","text":"Collection of AWS resources"},{"letter":"C","text":"S3 bucket"},{"letter":"D","text":"IAM role"}],"correctAnswer":"B","difficulty":"basic","explanation":{"correct":"Stack is a collection of resources.","why":"It represents deployed infrastructure."}},{"id":13,"question":"What does Replacement=True indicate?","options":[{"letter":"A","text":"No change"},{"letter":"B","text":"In-place update"},{"letter":"C","text":"Resource replacement"},{"letter":"D","text":"Deletion only"}],"correctAnswer":"C","difficulty":"intermediate","explanation":{"correct":"Resource will be recreated.","why":"Old resource is destroyed."}},{"id":25,"question":"What happens if you delete a stack with active exports?","options":[{"letter":"A","text":"Deletes normally"},{"letter":"B","text":"Fails deletion"},{"letter":"C","text":"Copies values"},{"letter":"D","text":"Ignores dependency"}],"correctAnswer":"B","difficulty":"advanced","explanation":{"correct":"Deletion is blocked.","why":"Dependent stacks must be removed first."}}]}